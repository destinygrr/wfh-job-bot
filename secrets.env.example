# ============================================================
#  COPY THIS FILE  →  secrets.env   and fill in your own values
#  (never share this file with anyone, and don't post it online)
# ============================================================

# --- OPTION 1 (RECOMMENDED): ntfy phone notifications -------
# Free, no account, most reliable. See SETUP-GUIDE.md Part 2A.
# Invent a hard-to-guess topic name (that name acts as your password).
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- OPTION 2: REAL WhatsApp from your own number (Green API) ---
# Free "Developer" plan: unlimited sends to up to 3 chats. See Part 2C.
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_CHAT_ID=

# --- OPTION 3 (legacy): CallMeBot WhatsApp -------------------
# This service has become unreliable since 2025 - use it only if yours works.
# Phone: country code + number, NO + sign and NO spaces  (India: 91XXXXXXXXXX)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- OPTION 2: Telegram (free, never breaks) -----------------
# Create a bot with @BotFather in Telegram, then find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- OPTIONAL: Jooble (free key) = more Indian jobs when Naukri blocks the cloud
# Get a free key at https://jooble.org/api/about  (2 minutes, free)
JOOBLE_API_KEY=

# --- OPTIONAL: e-mail copy of every alert --------------------
# Gmail: turn on 2-step verification, then create an "App password" and use it here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
